# 复制为根目录 .env 后填写。脚本会拒绝 __REQUIRED__ 占位符，切勿提交 .env。
COMPOSE_PROJECT_NAME=ai-career
APP_VERSION=production
WEB_PORT=80
SPRING_PROFILES_ACTIVE=prod
DOCKER_RUN_TESTS=false

MYSQL_DATABASE=ai_career
MYSQL_ROOT_PASSWORD=__REQUIRED__
DB_URL=jdbc:mysql://mysql:3306/ai_career?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=ai_career
DB_PASSWORD=__REQUIRED__
DB_MAX_POOL_SIZE=8
DB_MIN_IDLE=1

POSTGRES_DB=ai_career_rag
POSTGRES_USER=ai_career_rag
POSTGRES_PASSWORD=__REQUIRED__

RAG_PG_URL=jdbc:postgresql://pgvector:5432/ai_career_rag
RAG_PG_USERNAME=ai_career_rag
RAG_PG_PASSWORD=__REQUIRED__
RAG_KNOWLEDGE_DIR=/app/knowledge

AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=__REQUIRED__
AI_MODEL=qwen3.7-plus
AI_TIMEOUT=60s
AI_MAX_RETRIES=1
AI_STREAM_TIMEOUT=180s

RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=__REQUIRED__
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_TIMEOUT_SECONDS=15
RAG_EMBEDDING_MAX_RETRIES=0
RAG_MIN_SCORE=0.55
RAG_PG_CONNECT_TIMEOUT_SECONDS=3
RAG_PG_SOCKET_TIMEOUT_SECONDS=5
RAG_PG_QUERY_TIMEOUT_SECONDS=3

JWT_SECRET=__REQUIRED__
JWT_EXPIRATION_MILLIS=604800000

AI_RAG_ENABLED=true
AI_RAG_IMPORT=false
AI_CAREER_TOOLS_ENABLED=true
AI_TOOL_MAX_CALLS_PER_TOOL=2

OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=xucheng-zzyl
OSS_ACCESS_KEY_ID=__REQUIRED__
OSS_ACCESS_KEY_SECRET=__REQUIRED__
